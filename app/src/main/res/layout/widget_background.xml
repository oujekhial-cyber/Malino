<?xml version="1.0" encoding="utf-8"?>
<!--
  لایه پس‌زمینه ویجت.
  شفافیت هم روی تصویر و هم روی رنگ اعمال می‌شود تا «شیشه‌ای بودن» واقعاً
  تصویر زمینه گوشی را نشان دهد (اگر فقط رنگ شفاف می‌شد، تصویر مات زیرش
  همچنان دیده می‌شد و اثر شیشه‌ای از بین می‌رفت).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:id="@+id/widget_bg_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
