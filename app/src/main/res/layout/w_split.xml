<?xml version="1.0" encoding="utf-8"?>
<!--
  ریشه ویجت: یک تصویر پس‌زمینه (کارت گرد با رنگ تم و شفافیت کاربر)
  و روی آن، چیدمان قالب انتخابی.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

<!--
  قالب «دوبخشی»: مقادیر سمت راست، خط جداکننده عمودی، ساعت و تاریخ سمت چپ.
  (طرح‌های ۵ و ۶ کاربر)
-->
<LinearLayout
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:layoutDirection="rtl"
    android:padding="16dp"
    android:baselineAligned="false">

    <!-- ستون راست: عنوان و مقادیر -->
    <LinearLayout
        android:id="@+id/w_app_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="خرج‌یار"
            android:textStyle="bold"
            android:textSize="19sp"
            android:includeFontPadding="false"
            android:textColor="#E86FA8" />

        <ImageView
            android:id="@+id/w_title_rule"
            android:layout_width="64dp"
            android:layout_height="1dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="11dp"
            android:background="#33FFFFFF" android:contentDescription="@null" />

        <!-- ردیف درآمد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/w_circle">
                <ImageView
                    android:id="@+id/w_icon_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/w_ic_up"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/w_label_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#F3E6F2" />

            <TextView
                android:id="@+id/w_value_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#FFE3F0" />
        </LinearLayout>

        <!-- ردیف هزینه -->
        <LinearLayout
            android:id="@+id/w_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/w_circle">
                <ImageView
                    android:id="@+id/w_icon_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/w_ic_down"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/w_label_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#F3E6F2" />

            <TextView
                android:id="@+id/w_value_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#FFE3F0" />
        </LinearLayout>

        <!-- ردیف سوم (مانده حساب) — در صورت وجود -->
        <LinearLayout
            android:id="@+id/w_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_label_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#F3E6F2" />

            <TextView
                android:id="@+id/w_value_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#FFE3F0" />
        </LinearLayout>
    </LinearLayout>

    <!-- خط جداکننده عمودی -->
    <ImageView
        android:id="@+id/w_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="14dp"
        android:background="#2EFFFFFF" android:contentDescription="@null" />

    <!-- ستون چپ: ساعت و تاریخ (ناحیه کلیک برنامه ساعت) -->
    <LinearLayout
        android:id="@+id/w_clock_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical|start">

        <TextClock
            android:id="@+id/w_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="@null"
            android:format24Hour="HH:mm"
            android:textSize="44sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:lines="1"
            android:textColor="#FFE3F0" />

        <TextView
            android:id="@+id/w_jalali"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:textColor="#F3E6F2" />

        <TextClock
            android:id="@+id/w_gregorian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="d MMM yyyy"
            android:format24Hour="d MMM yyyy"
            android:maxLines="1"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:textColor="#B9A8C4" />
    </LinearLayout>
</LinearLayout>
    <TextView
        android:id="@+id/w_weather"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|center_horizontal"
        android:padding="12dp"
        android:maxLines="1"
        android:textSize="12sp"
        android:textColor="#FFFFFF" />

</FrameLayout>
